# Local development persists data in .data/crops automatically.
# For Netlify, set these in Site configuration > Environment variables.
# Use a PostgreSQL provider's pooled TLS connection string.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# CROPS_ALLOW_REGISTRATION=false
# CROPS_ALLOWED_ORIGINS=https://crops.wims.vc
# Local sample workspace only (never enabled in production):
# CROPS_SEED_DEMO=true
