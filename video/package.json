{
  "name": "crops-launch-video",
  "private": true,
  "type": "module",
  "description": "Crops launch video, rendered with Remotion at 1920x1080 60fps.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "beats": "python3 scripts/analyze-beats.py public/soundtrack.mp3 60",
    "render": "remotion render src/index.ts CropsLaunch out/crops-launch.mp4 --codec=h264 --crf=16 --audio-bitrate=320k",
    "still": "remotion still src/index.ts CropsLaunch out/still.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.525",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.525"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
